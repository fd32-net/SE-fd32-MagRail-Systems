      <Id>
        <TypeId>ModStorageComponent</TypeId>
        <SubtypeId>MagRail_Storage</SubtypeId>
      </Id>
      <RegisteredStorageGuids>
        <!-- Track block settings (TrackBlockLogic) -->
        <guid>444da85b-4de9-4530-8b2a-10d8f75d9c76</guid>
      </RegisteredStorageGuids>
    </EntityComponent>
  </EntityComponents>
</Definitions>
