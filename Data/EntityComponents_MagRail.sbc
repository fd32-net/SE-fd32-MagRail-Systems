<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>
    <!-- Every Storage GUID the script writes must be listed here, or the game drops it on save. -->
    <EntityComponent xsi:type="MyObjectBuilder_ModStorageComponentDefinition">
      <Id>
        <TypeId>ModStorageComponent</TypeId>
        <SubtypeId>MagRail_Storage</SubtypeId>
      </Id>
      <RegisteredStorageGuids>
        <!-- Track block settings (TrackBlockLogic) -->
        <guid>444da85b-4de9-4530-8b2a-10d8f75d9c76</guid>
        <!-- Spans owned by a track block (TrackBlockLogic) -->
        <guid>b0b3f1c2-6f7e-4d84-9a51-2c8e7d3f4a60</guid>
        <!-- Hover engine settings (HoverEngineLogic) -->
        <guid>680eadb9-ba93-4634-accb-e32545f16dc7</guid>
      </RegisteredStorageGuids>
    </EntityComponent>
  </EntityComponents>
</Definitions>
