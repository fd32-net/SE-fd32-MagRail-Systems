<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <HandItems>
    <!-- Rail Linker: the vanilla HandToolBase entity with no tool actions, so LMB/RMB do nothing
         in the game and the mod script reads them (Tools/RailLinker.cs). Its model keeps the welder's grip and
         origin (PhysicalItems_MagRail.sbc): hand pose, sway and fingers copied from the vanilla Welder, and it is
         held by the welder's animation (TransformFromAnim; Data/AnimationControllers/AC_Astronaut*_MagRail.sbc
         plays it on the equip event MagRail_RailLinker; ironsight from this data, as the Paint Gun does).
         While a mouse button is held the character "shoots" (HandToolBase.CanShoot: OK, GetShakeOnAction: true) and
         the tool blends to ItemShoot* from this data: the welder's push forwards (the vanilla welder uses data for
         every state), arms following by IK; without the welder's tilt (it points the welder's tip at the crosshair,
         but tips the ruler down) and without its drop. -->
    <HandItem xsi:type="MyObjectBuilder_HandItemDefinition">
      <Id Type="MyObjectBuilder_HandToolBase" Subtype="MagRail_RailLinker" />
      <LeftHandOrientation>
        <X>-0.707107961</X>
        <Y>-3.905627E-07</Y>
        <Z>-1.68587874E-07</Z>
        <W>0.7071056</W>
      </LeftHandOrientation>
      <LeftHandPosition>
        <X>-0.08030445</X>
        <Y>-0.114194907</Y>
        <Z>-0.06793878</Z>
      </LeftHandPosition>
      <RightHandOrientation>
        <X>-0.365488321</X>
        <Y>-0.48690632</Y>
        <Z>-0.5507982</Z>
        <W>0.5709306</W>
      </RightHandOrientation>
      <RightHandPosition>
        <X>0.021914959</X>
        <Y>-0.062458396</Y>
        <Z>0.120534658</Z>
      </RightHandPosition>
      <ItemOrientation>
        <X>0</X>
        <Y>0</Y>
        <Z>0</Z>
        <W>1</W>
      </ItemOrientation>
      <ItemPosition>
        <X>0.100000024</X>
        <Y>-0.18</Y>
        <Z>-0.220000029</Z>
      </ItemPosition>
      <ItemWalkingOrientation>
        <X>0</X>
        <Y>0</Y>
