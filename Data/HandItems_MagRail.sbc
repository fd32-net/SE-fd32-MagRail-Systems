        <W>1</W>
      </ItemShootOrientation>
      <ItemShootPosition>
        <X>0.100000024</X>
        <Y>-0.18</Y>
        <Z>-0.338593721</Z>
      </ItemShootPosition>
      <ItemIronsightOrientation>
        <X>0</X>
        <Y>0</Y>
        <Z>0</Z>
        <W>1</W>
      </ItemIronsightOrientation>
      <ItemIronsightPosition>
        <X>0</X>
        <Y>-0.21</Y>
        <Z>-0.25</Z>
      </ItemIronsightPosition>
      <ItemOrientation3rd>
