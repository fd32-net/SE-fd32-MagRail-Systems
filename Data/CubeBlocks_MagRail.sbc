<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- Track blocks (large grid only). UpgradeModule = a functional terminal block without inventory
       or vanilla behaviour; the mod script gives it its logic. The rail is a subpart of the model
       (ports are dummies in it), see ModelSource/blocks/TrackBlocks.py. -->
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>MagRail_RailBlock1</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_RailBlock1</DisplayName>
      <Description>Description_MagRail_RailBlock1</Description>
      <Icon>Textures\Icons\Blocks\MagRail_RailBlock1.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\MagRail_RailBlock1.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="4" />
        <Component Subtype="Construction" Count="6" />
        <Component Subtype="MetalGrid" Count="4" />
      </Components>
      <CriticalComponent Subtype="MetalGrid" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
      </MountPoints>
      <BlockPairName>MagRail_RailBlock1</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>8</BuildTimeSeconds>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>10</PCU>
      <IsAirTight>false</IsAirTight>
      <Upgrades />
    </Definition>
    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>MagRail_RailBlock5</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_RailBlock5</DisplayName>
      <Description>Description_MagRail_RailBlock5</Description>
      <Icon>Textures\Icons\Blocks\MagRail_RailBlock5.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="5" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\MagRail_RailBlock5.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="10" />
        <Component Subtype="Construction" Count="20" />
        <Component Subtype="MetalGrid" Count="15" />
      </Components>
      <CriticalComponent Subtype="MetalGrid" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
        <MountPoint Side="Bottom" StartX="0" StartY="4" EndX="1" EndY="5" />
      </MountPoints>
      <BlockPairName>MagRail_RailBlock5</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>20</BuildTimeSeconds>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>15</PCU>
      <IsAirTight>false</IsAirTight>
      <Upgrades />
    </Definition>
    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>MagRail_FreeRail</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_FreeRail</DisplayName>
      <Description>Description_MagRail_FreeRail</Description>
      <Icon>Textures\Icons\Blocks\MagRail_FreeRail.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\MagRail_FreeRail.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="4" />
        <Component Subtype="Construction" Count="8" />
        <Component Subtype="MetalGrid" Count="4" />
        <Component Subtype="Motor" Count="2" />
        <Component Subtype="Computer" Count="2" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
      </MountPoints>
      <BlockPairName>MagRail_FreeRail</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>12</BuildTimeSeconds>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>15</PCU>
      <IsAirTight>false</IsAirTight>
      <Upgrades />
    </Definition>
    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>MagRail_Switch</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_Switch</DisplayName>
      <Description>Description_MagRail_Switch</Description>
      <Icon>Textures\Icons\Blocks\MagRail_Switch.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="2" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\MagRail_Switch.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="8" />
        <Component Subtype="Construction" Count="12" />
        <Component Subtype="MetalGrid" Count="6" />
        <Component Subtype="Motor" Count="4" />
        <Component Subtype="Computer" Count="4" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="2" Default="true" />
      </MountPoints>
      <BlockPairName>MagRail_Switch</BlockPairName>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>16</BuildTimeSeconds>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>25</PCU>
      <IsAirTight>false</IsAirTight>
      <Upgrades />
    </Definition>
    <!-- Hover engines: a wheel suspension without a wheel (RotorPart names no block group, so the game spawns
         none), the script holds the grid over the rail. Numbers are the old Maglev engines'. -->
    <Definition xsi:type="MyObjectBuilder_MotorSuspensionDefinition">
      <Id>
        <TypeId>MotorSuspension</TypeId>
        <SubtypeId>MagRail_HoverLarge</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_HoverLarge</DisplayName>
      <Description>Description_MagRail_HoverLarge</Description>
      <Icon>Textures\Icons\Blocks\MagRail_HoverLarge.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\MagRail_HoverLarge.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="50" />
        <Component Subtype="Construction" Count="20" />
        <Component Subtype="Superconductor" Count="15" />
        <Component Subtype="Computer" Count="50" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MountPoints>
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Front" StartX="0" StartY="0.6" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="0.6" EndX="1" EndY="1" />
        <MountPoint Side="Left" StartX="0" StartY="0.6" EndX="1" EndY="1" />
        <MountPoint Side="Right" StartX="0" StartY="0.6" EndX="1" EndY="1" />
      </MountPoints>
      <BlockPairName>MagRail_HoverEngine</BlockPairName>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <BuildTimeSeconds>20</BuildTimeSeconds>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <RequiredPowerInput>5</RequiredPowerInput>
      <RequiredIdlePowerInput>0</RequiredIdlePowerInput>
      <MaxForceMagnitude>1E9</MaxForceMagnitude>
      <DangerousTorqueThreshold>3.36E+07</DangerousTorqueThreshold>
      <PropulsionForce>20000</PropulsionForce>
      <RotorPart>MagRail_NoWheel</RotorPart>
      <MaxSteer>0.0</MaxSteer>
      <MinHeight>-1.5</MinHeight>
      <MaxHeight>1.3</MaxHeight>
      <SafetyDetach>5</SafetyDetach>
      <SafetyDetachMax>5</SafetyDetachMax>
      <AxleFriction>20000</AxleFriction>
      <SteeringSpeed>0.005</SteeringSpeed>
      <AirShockMinSpeed>10</AirShockMinSpeed>
      <AirShockMaxSpeed>25</AirShockMaxSpeed>
      <AirShockActivationDelay>60</AirShockActivationDelay>
      <PCU>20</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>
    <Definition xsi:type="MyObjectBuilder_MotorSuspensionDefinition">
      <Id>
        <TypeId>MotorSuspension</TypeId>
        <SubtypeId>MagRail_HoverSmall</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_HoverSmall</DisplayName>
      <Description>Description_MagRail_HoverSmall</Description>
      <Icon>Textures\Icons\Blocks\MagRail_HoverSmall.dds</Icon>
