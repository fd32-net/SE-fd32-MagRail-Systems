<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- Engines, Train Control Unit, Autopilot. The track blocks are in RailType_<type>.sbc. -->
  <CubeBlocks>
    <!-- Hover engines: a wheel suspension without a wheel (RotorPart names no block group, so the game spawns
         none), the script holds the grid over the rail; the platform under the base follows the rail
         (EnginePlatform, blocks/Engine.py). One engine on both grids: the small grid one is the same 2.5 m engine,
         5x1x5, its base fills the cell. Side mount points: the base's slab, its top 0.4 m. -->
    <Definition xsi:type="MyObjectBuilder_MotorSuspensionDefinition">
      <Id>
        <TypeId>MotorSuspension</TypeId>
        <SubtypeId>MagRail_EngineLarge</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_Engine</DisplayName>
      <Description>Description_MagRail_Engine</Description>
      <Icon>Textures\Icons\Blocks\MagRail_EngineLarge.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\MagRail_EngineLarge.mwm</Model>
      <Components>
        <Component Subtype="MetalGrid" Count="10" />
        <Component Subtype="SteelPlate" Count="20" />
        <Component Subtype="Construction" Count="30" />
        <Component Subtype="LargeTube" Count="4" />
        <Component Subtype="Superconductor" Count="20" />
        <Component Subtype="Motor" Count="8" />
        <Component Subtype="Computer" Count="8" />
        <Component Subtype="SteelPlate" Count="20" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MountPoints>
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Front" StartX="0" StartY="0.84" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="0.84" EndX="1" EndY="1" />
        <MountPoint Side="Left" StartX="0" StartY="0.84" EndX="1" EndY="1" />
        <MountPoint Side="Right" StartX="0" StartY="0.84" EndX="1" EndY="1" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\MagRail_EngineLargeConstruction_1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\MagRail_EngineLargeConstruction_2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\MagRail_EngineLargeConstruction_3.mwm" />
      </BuildProgressModels>
      <BlockPairName>MagRail_Engine</BlockPairName>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <BuildTimeSeconds>30</BuildTimeSeconds>
      <ResourceSinkGroup>Thrust</ResourceSinkGroup>
      <RequiredPowerInput>5</RequiredPowerInput>
      <RequiredIdlePowerInput>0</RequiredIdlePowerInput>
      <MaxForceMagnitude>1E9</MaxForceMagnitude>
      <DangerousTorqueThreshold>3.36E+07</DangerousTorqueThreshold>
      <PropulsionForce>20000</PropulsionForce>
      <RotorPart>MagRail_NoWheel</RotorPart>
      <MaxSteer>0.0</MaxSteer>
      <MinHeight>-1.5</MinHeight>
      <MaxHeight>1.3</MaxHeight>
      <SafetyDetach>5</SafetyDetach>
      <SafetyDetachMax>5</SafetyDetachMax>
      <AxleFriction>20000</AxleFriction>
      <SteeringSpeed>0.005</SteeringSpeed>
      <AirShockMinSpeed>10</AirShockMinSpeed>
      <AirShockMaxSpeed>25</AirShockMaxSpeed>
      <AirShockActivationDelay>60</AirShockActivationDelay>
      <PCU>20</PCU>
    </Definition>
    <Definition xsi:type="MyObjectBuilder_MotorSuspensionDefinition">
      <Id>
        <TypeId>MotorSuspension</TypeId>
        <SubtypeId>MagRail_EngineSmall</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_Engine</DisplayName>
      <Description>Description_MagRail_Engine</Description>
      <Icon>Textures\Icons\Blocks\MagRail_EngineSmall.dds</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="5" y="1" z="5" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\MagRail_EngineSmall.mwm</Model>
      <Components>
        <Component Subtype="MetalGrid" Count="6" />
        <Component Subtype="SteelPlate" Count="6" />
        <Component Subtype="Construction" Count="20" />
        <Component Subtype="LargeTube" Count="2" />
        <Component Subtype="Superconductor" Count="20" />
        <Component Subtype="Motor" Count="8" />
        <Component Subtype="Computer" Count="8" />
        <Component Subtype="SteelPlate" Count="9" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MountPoints>
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="5" EndY="5" />
        <MountPoint Side="Front" StartX="0" StartY="0.2" EndX="5" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="0.2" EndX="5" EndY="1" />
        <MountPoint Side="Left" StartX="0" StartY="0.2" EndX="5" EndY="1" />
        <MountPoint Side="Right" StartX="0" StartY="0.2" EndX="5" EndY="1" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Small\MagRail_EngineSmallConstruction_1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Small\MagRail_EngineSmallConstruction_2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Small\MagRail_EngineSmallConstruction_3.mwm" />
      </BuildProgressModels>
      <BlockPairName>MagRail_Engine</BlockPairName>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <BuildTimeSeconds>24</BuildTimeSeconds>
      <ResourceSinkGroup>Thrust</ResourceSinkGroup>
      <RequiredPowerInput>5</RequiredPowerInput>
      <RequiredIdlePowerInput>0</RequiredIdlePowerInput>
      <MaxForceMagnitude>1E9</MaxForceMagnitude>
      <DangerousTorqueThreshold>3.36E+07</DangerousTorqueThreshold>
      <PropulsionForce>20000</PropulsionForce>
      <RotorPart>MagRail_NoWheel</RotorPart>
      <MaxSteer>0.0</MaxSteer>
      <MinHeight>-1.5</MinHeight>
      <MaxHeight>1.3</MaxHeight>
      <SafetyDetach>5</SafetyDetach>
      <SafetyDetachMax>5</SafetyDetachMax>
      <AxleFriction>20000</AxleFriction>
      <SteeringSpeed>0.005</SteeringSpeed>
      <AirShockMinSpeed>10</AirShockMinSpeed>
      <AirShockMaxSpeed>25</AirShockMaxSpeed>
      <AirShockActivationDelay>60</AirShockActivationDelay>
      <PCU>20</PCU>
    </Definition>
    <!-- The small grid's own small engine: 1x1x1, its own model (blocks/EngineMini.py), the base in the top 0.27 m of
         the cell, the platform hangs under the block. A quarter of the engine's force and power. -->
    <Definition xsi:type="MyObjectBuilder_MotorSuspensionDefinition">
      <Id>
        <TypeId>MotorSuspension</TypeId>
        <SubtypeId>MagRail_EngineMini</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_EngineMini</DisplayName>
      <Description>Description_MagRail_EngineMini</Description>
      <Icon>Textures\Icons\Blocks\MagRail_EngineMini.dds</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\MagRail_EngineMini.mwm</Model>
      <Components>
        <Component Subtype="MetalGrid" Count="2" />
        <Component Subtype="SteelPlate" Count="1" />
        <Component Subtype="Construction" Count="6" />
        <Component Subtype="SmallTube" Count="2" />
        <Component Subtype="Superconductor" Count="3" />
        <Component Subtype="Motor" Count="2" />
        <Component Subtype="Computer" Count="2" />
        <Component Subtype="SteelPlate" Count="3" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MountPoints>
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Front" StartX="0" StartY="0.46" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="0.46" EndX="1" EndY="1" />
        <MountPoint Side="Left" StartX="0" StartY="0.46" EndX="1" EndY="1" />
        <MountPoint Side="Right" StartX="0" StartY="0.46" EndX="1" EndY="1" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.50" File="Models\Cubes\Small\MagRail_EngineMiniConstruction_1.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Small\MagRail_EngineMiniConstruction_2.mwm" />
      </BuildProgressModels>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <BuildTimeSeconds>12</BuildTimeSeconds>
      <ResourceSinkGroup>Thrust</ResourceSinkGroup>
      <RequiredPowerInput>1.25</RequiredPowerInput>
      <RequiredIdlePowerInput>0</RequiredIdlePowerInput>
      <MaxForceMagnitude>1E9</MaxForceMagnitude>
      <DangerousTorqueThreshold>3.36E+07</DangerousTorqueThreshold>
      <PropulsionForce>20000</PropulsionForce>
      <RotorPart>MagRail_NoWheel</RotorPart>
      <MaxSteer>0.0</MaxSteer>
      <MinHeight>-1.5</MinHeight>
      <MaxHeight>1.3</MaxHeight>
      <SafetyDetach>5</SafetyDetach>
      <SafetyDetachMax>5</SafetyDetachMax>
      <AxleFriction>20000</AxleFriction>
      <SteeringSpeed>0.005</SteeringSpeed>
      <AirShockMinSpeed>10</AirShockMinSpeed>
      <AirShockMaxSpeed>25</AirShockMaxSpeed>
      <AirShockActivationDelay>60</AirShockActivationDelay>
      <PCU>20</PCU>
    </Definition>
    <!-- Train Control Unit: a thruster with (almost) no force. A grid has the vanilla inertia dampeners (Z, the
         cockpit's checkbox, the HUD) only while a working thruster is on it, so the cockpit grid of a train needs
         one; the drive reads the flag. The vanilla AI Flight (Move) block's model with our glyph plates, turned round so its arrows show the cruise way
         (blocks/AiBlocks.py). ForceMagnitude is not 0: the
         game divides by it (override power, thrust percentage). -->
    <Definition xsi:type="MyObjectBuilder_ThrustDefinition">
      <Id>
        <TypeId>Thrust</TypeId>
        <SubtypeId>MagRail_TrainControlLarge</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_TrainControl</DisplayName>
      <Description>Description_MagRail_TrainControl</Description>
      <Icon>Textures\GUI\Icons\Cubes\FlightMovementBlock_Move.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\MagRail_TrainControlLarge.mwm</Model>
      <Components>
        <Component Subtype="InteriorPlate" Count="20" />
        <Component Subtype="Construction" Count="30" />
        <Component Subtype="Motor" Count="4" />
        <Component Subtype="Computer" Count="20" />
        <Component Subtype="SteelPlate" Count="20" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="0.3" EndY="1" Default="true" />
        <MountPoint Side="Bottom" StartX="0.7" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Bottom" StartX="0.3" StartY="0.15" EndX="0.7" EndY="0.85" />
        <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="0.3" EndY="1" />
        <MountPoint Side="Back" StartX="0.7" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0.3" StartY="0.15" EndX="0.7" EndY="0.85" />
        <MountPoint Side="Front" StartX="0" StartY="0" EndX="0.3" EndY="1" />
        <MountPoint Side="Front" StartX="0.7" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Front" StartX="0.3" StartY="0.15" EndX="0.7" EndY="0.85" />
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="0.3" EndY="1" />
        <MountPoint Side="Top" StartX="0.7" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Top" StartX="0.3" StartY="0.15" EndX="0.7" EndY="0.85" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\DroneFeatureBlockConstruction_1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\DroneFeatureBlockConstruction_2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\DroneFeatureBlockConstruction_3.mwm" />
      </BuildProgressModels>
      <BlockPairName>MagRail_TrainControl</BlockPairName>
      <MirroringZ>Y</MirroringZ>
      <MirroringY>Z</MirroringY>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>24</BuildTimeSeconds>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <PCU>25</PCU>
      <ThrusterType>Ion</ThrusterType>
      <ResourceSinkGroup>Thrust</ResourceSinkGroup>
      <ForceMagnitude>0.001</ForceMagnitude>
      <MaxPowerConsumption>0</MaxPowerConsumption>
      <MinPowerConsumption>0</MinPowerConsumption>
      <SlowdownFactor>1</SlowdownFactor>
      <MinPlanetaryInfluence>0</MinPlanetaryInfluence>
      <MaxPlanetaryInfluence>1</MaxPlanetaryInfluence>
      <EffectivenessAtMinInfluence>1</EffectivenessAtMinInfluence>
      <EffectivenessAtMaxInfluence>1</EffectivenessAtMaxInfluence>
      <FlameDamageLengthScale>0</FlameDamageLengthScale>
      <FlameDamage>0</FlameDamage>
      <FlameLengthScale>0</FlameLengthScale>
    </Definition>
    <Definition xsi:type="MyObjectBuilder_ThrustDefinition">
      <Id>
        <TypeId>Thrust</TypeId>
        <SubtypeId>MagRail_TrainControlSmall</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_TrainControl</DisplayName>
      <Description>Description_MagRail_TrainControl</Description>
      <Icon>Textures\GUI\Icons\Cubes\FlightMovementBlock_Move.dds</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\MagRail_TrainControlSmall.mwm</Model>
      <Components>
        <Component Subtype="InteriorPlate" Count="2" />
        <Component Subtype="Construction" Count="5" />
        <Component Subtype="Motor" Count="2" />
        <Component Subtype="Computer" Count="10" />
        <Component Subtype="SteelPlate" Count="2" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
        <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.50" File="Models\Cubes\Small\DroneFeatureBlockConstruction_1.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Small\DroneFeatureBlockConstruction_2.mwm" />
      </BuildProgressModels>
      <BlockPairName>MagRail_TrainControl</BlockPairName>
      <MirroringZ>Y</MirroringZ>
      <MirroringY>Z</MirroringY>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>10</BuildTimeSeconds>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <PCU>25</PCU>
      <ThrusterType>Ion</ThrusterType>
      <ResourceSinkGroup>Thrust</ResourceSinkGroup>
      <ForceMagnitude>0.001</ForceMagnitude>
      <MaxPowerConsumption>0</MaxPowerConsumption>
      <MinPowerConsumption>0</MinPowerConsumption>
      <SlowdownFactor>1</SlowdownFactor>
      <MinPlanetaryInfluence>0</MinPlanetaryInfluence>
      <MaxPlanetaryInfluence>1</MaxPlanetaryInfluence>
      <EffectivenessAtMinInfluence>1</EffectivenessAtMinInfluence>
      <EffectivenessAtMaxInfluence>1</EffectivenessAtMaxInfluence>
      <FlameDamageLengthScale>0</FlameDamageLengthScale>
      <FlameDamage>0</FlameDamage>
      <FlameLengthScale>0</FlameLengthScale>
    </Definition>
    <!-- Autopilot (AutopilotLogic): the vanilla AI Task block's model with our glyph plates (blocks/AiBlocks.py), own logic. -->
    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>MagRail_AutopilotLarge</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_Autopilot</DisplayName>
      <Description>Description_MagRail_Autopilot</Description>
      <Icon>Textures\GUI\Icons\Cubes\PathRecorderBlock_Task.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\MagRail_AutopilotLarge.mwm</Model>
      <Components>
        <Component Subtype="InteriorPlate" Count="20" />
        <Component Subtype="Construction" Count="30" />
        <Component Subtype="Motor" Count="4" />
        <Component Subtype="Computer" Count="50" />
        <Component Subtype="SteelPlate" Count="20" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="0.3" EndY="1" Default="true" />
        <MountPoint Side="Bottom" StartX="0.7" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Bottom" StartX="0.3" StartY="0.15" EndX="0.7" EndY="0.85" />
        <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="0.3" EndY="1" />
        <MountPoint Side="Back" StartX="0.7" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0.3" StartY="0.15" EndX="0.7" EndY="0.85" />
        <MountPoint Side="Front" StartX="0" StartY="0" EndX="0.3" EndY="1" />
        <MountPoint Side="Front" StartX="0.7" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Front" StartX="0.3" StartY="0.15" EndX="0.7" EndY="0.85" />
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="0.3" EndY="1" />
        <MountPoint Side="Top" StartX="0.7" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Top" StartX="0.3" StartY="0.15" EndX="0.7" EndY="0.85" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\DroneFeatureBlockConstruction_1.mwm" />
        <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\DroneFeatureBlockConstruction_2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\DroneFeatureBlockConstruction_3.mwm" />
      </BuildProgressModels>
      <BlockPairName>MagRail_Autopilot</BlockPairName>
      <MirroringZ>Y</MirroringZ>
      <MirroringY>Z</MirroringY>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>24</BuildTimeSeconds>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <PCU>25</PCU>
    </Definition>
    <!-- Autopilot (AutopilotLogic): the vanilla AI Task block's model with our glyph plates (blocks/AiBlocks.py), own logic. -->
    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>MagRail_AutopilotSmall</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_Autopilot</DisplayName>
      <Description>Description_MagRail_Autopilot</Description>
      <Icon>Textures\GUI\Icons\Cubes\PathRecorderBlock_Task.dds</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\MagRail_AutopilotSmall.mwm</Model>
      <Components>
        <Component Subtype="InteriorPlate" Count="2" />
        <Component Subtype="Construction" Count="5" />
        <Component Subtype="Motor" Count="2" />
        <Component Subtype="Computer" Count="25" />
        <Component Subtype="SteelPlate" Count="2" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
        <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.50" File="Models\Cubes\Small\DroneFeatureBlockConstruction_1.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Small\DroneFeatureBlockConstruction_2.mwm" />
      </BuildProgressModels>
      <BlockPairName>MagRail_Autopilot</BlockPairName>
      <MirroringZ>Y</MirroringZ>
      <MirroringY>Z</MirroringY>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>10</BuildTimeSeconds>
      <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <PCU>25</PCU>
    </Definition>
  </CubeBlocks>
</Definitions>
