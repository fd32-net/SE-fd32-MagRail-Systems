    <!-- The switch: the model of the type's Rail Block 1, one entry and three branch ports in one point at the
         front end (like the old Maglev junction), see ModelSource/blocks/Switch1.py. -->
    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>MagRail_Switch1</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_Switch1</DisplayName>
      <Description>Description_MagRail_Switch1</Description>
      <Icon>Textures\Icons\Blocks\MagRail_Switch1.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\MagRail_Switch1.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="4" />
        <Component Subtype="Construction" Count="6" />
        <Component Subtype="MetalGrid" Count="4" />
        <Component Subtype="Computer" Count="2" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <!-- Placed by the back cell (Center), bottom mount points on the end cells, mount points on both ends. -->
      <Center x="0" y="0" z="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" />
        <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="1" />
