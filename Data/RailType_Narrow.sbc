    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>MagRail_FreeRail</SubtypeId>
      </Id>
      <DisplayName>DisplayName_MagRail_FreeRail</DisplayName>
      <Description>Description_MagRail_FreeRail</Description>
      <Icon>Textures\Icons\Blocks\MagRail_FreeRail.dds</Icon>
