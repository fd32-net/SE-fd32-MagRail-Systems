  </CubeBlocks>
  <!-- G menu: the type's blocks in one group; the first block is the group icon. -->
  <BlockVariantGroups>
    <BlockVariantGroup>
      <Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="MagRail_TrackGroup" />
      <DisplayName>DisplayName_MagRail_TrackGroup</DisplayName>
      <Description>Description_MagRail_TrackGroup</Description>
      <Blocks>
        <Block Type="UpgradeModule" Subtype="MagRail_RailBlock1" />
        <Block Type="UpgradeModule" Subtype="MagRail_RailBlock5" />
        <Block Type="UpgradeModule" Subtype="MagRail_RailBlock10" />
        <Block Type="UpgradeModule" Subtype="MagRail_RailBlock20" />
        <Block Type="UpgradeModule" Subtype="MagRail_FreeRail" />
        <Block Type="UpgradeModule" Subtype="MagRail_Switch1" />
      </Blocks>
    </BlockVariantGroup>
  </BlockVariantGroups>
  <!-- Progression: research group 16, like the old Maglev blocks. -->
  <ResearchBlocks>
    <ResearchBlock xsi:type="ResearchBlock"><Id Type="UpgradeModule" Subtype="MagRail_RailBlock1" /><UnlockedByGroups><GroupSubtype>16</GroupSubtype></UnlockedByGroups></ResearchBlock>
    <ResearchBlock xsi:type="ResearchBlock"><Id Type="UpgradeModule" Subtype="MagRail_RailBlock5" /><UnlockedByGroups><GroupSubtype>16</GroupSubtype></UnlockedByGroups></ResearchBlock>
    <ResearchBlock xsi:type="ResearchBlock"><Id Type="UpgradeModule" Subtype="MagRail_RailBlock10" /><UnlockedByGroups><GroupSubtype>16</GroupSubtype></UnlockedByGroups></ResearchBlock>
    <ResearchBlock xsi:type="ResearchBlock"><Id Type="UpgradeModule" Subtype="MagRail_RailBlock20" /><UnlockedByGroups><GroupSubtype>16</GroupSubtype></UnlockedByGroups></ResearchBlock>
    <ResearchBlock xsi:type="ResearchBlock"><Id Type="UpgradeModule" Subtype="MagRail_FreeRail" /><UnlockedByGroups><GroupSubtype>16</GroupSubtype></UnlockedByGroups></ResearchBlock>
    <ResearchBlock xsi:type="ResearchBlock"><Id Type="UpgradeModule" Subtype="MagRail_Switch1" /><UnlockedByGroups><GroupSubtype>16</GroupSubtype></UnlockedByGroups></ResearchBlock>
  </ResearchBlocks>
  <!-- Rail Linker end face overlays (TrackStyle.Face, Visuals/Draw.cs): MagRail_FaceNarrow<part><Line|Fill>,
       textures from ModelSource/overlay_textures.py. -->
  <TransparentMaterials>
    <TransparentMaterial>
      <Id>
        <TypeId>TransparentMaterialDefinition</TypeId>
        <SubtypeId>MagRail_FaceNarrowLine</SubtypeId>
      </Id>
      <AlphaMistingEnable>false</AlphaMistingEnable>
      <AlphaSaturation>1</AlphaSaturation>
      <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
      <IgnoreDepth>false</IgnoreDepth>
      <SoftParticleDistanceScale>0.1</SoftParticleDistanceScale>
      <Texture>Textures\Overlay\FaceNarrowLine.dds</Texture>
      <UseAtlas>false</UseAtlas>
      <Reflectivity>0</Reflectivity>
    </TransparentMaterial>
