<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CategoryClasses>
    <!-- The game merges categories of the same Name: the Rail Linker joins the vanilla
         Character Items and Character Tools tabs, next to the welder. -->
    <Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
      <Id>
        <TypeId>GuiBlockCategoryDefinition</TypeId>
        <SubtypeId />
      </Id>
      <DisplayName>DisplayName_Category_CharacterItems</DisplayName>
      <Name>Section0_Position1_CharacterItems</Name>
      <SearchBlocks>false</SearchBlocks>
      <IsToolCategory>true</IsToolCategory>
      <ItemIds>
        <string>PhysicalGunObject/MagRail_RailLinker</string>
      </ItemIds>
    </Category>
    <Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
      <Id>
        <TypeId>GuiBlockCategoryDefinition</TypeId>
        <SubtypeId />
      </Id>
      <DisplayName>DisplayName_Category_CharacterTools</DisplayName>
      <Name>Section0_Position2_CharacterTools</Name>
      <SearchBlocks>false</SearchBlocks>
      <IsToolCategory>true</IsToolCategory>
      <ItemIds>
        <string>PhysicalGunObject/MagRail_RailLinker</string>
      </ItemIds>
    </Category>
    <Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
      <Id>
        <TypeId>GuiBlockCategoryDefinition</TypeId>
        <SubtypeId />
      </Id>
      <DisplayName>DisplayName_MagRail_Category</DisplayName>
      <Name>MagRail Systems</Name>
      <SearchBlocks>true</SearchBlocks>
      <IsBlockCategory>true</IsBlockCategory>
      <ItemIds>
        <string>UpgradeModule/MagRail_RailBlock1</string>
        <string>UpgradeModule/MagRail_FreeRail</string>
        <string>UpgradeModule/MagRail_Switch1</string>
        <string>UpgradeModule/MagRail_EmbeddedRail</string>
        <string>UpgradeModule/MagRail_EmbeddedRailHalf</string>
        <string>UpgradeModule/MagRail_WideRailBlock1</string>
        <string>UpgradeModule/MagRail_WideFreeRail</string>
        <string>UpgradeModule/MagRail_WideSwitch1</string>
        <string>UpgradeModule/MagRail_WideEmbeddedRail</string>
        <string>UpgradeModule/MagRail_WideEmbeddedRailHalf</string>
        <string>MotorSuspension/MagRail_EngineLarge</string>
        <string>MotorSuspension/MagRail_EngineSmall</string>
        <string>Thrust/MagRail_TrainControlLarge</string>
        <string>Thrust/MagRail_TrainControlSmall</string>
        <string>UpgradeModule/MagRail_AutopilotLarge</string>
        <string>UpgradeModule/MagRail_AutopilotSmall</string>
      </ItemIds>
    </Category>
  </CategoryClasses>
</Definitions>
