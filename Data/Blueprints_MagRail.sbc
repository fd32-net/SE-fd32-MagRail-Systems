<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- Rail Linker: own cost (more silicon than the vanilla welder); made in the assembler only
       (EliteTools; Tools would add the basic assembler), not in survival kits.
       Rail component (Components_MagRail.sbc): assembler only (Components; SimpleComponents would add
       the basic assembler, BasicComponents the survival kit). -->
  <Blueprints>
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>MagRail_RailLinker</SubtypeId>
      </Id>
      <DisplayName>DisplayName_Item_MagRail_RailLinker</DisplayName>
      <Icon>Textures\Icons\RailLinker.dds</Icon>
      <Prerequisites>
        <Item Amount="5" TypeId="Ingot" SubtypeId="Iron" />
        <Item Amount="10" TypeId="Ingot" SubtypeId="Silicon" />
      </Prerequisites>
      <Result Amount="1" TypeId="PhysicalGunObject" SubtypeId="MagRail_RailLinker" />
      <BaseProductionTimeInSeconds>5</BaseProductionTimeInSeconds>
      <IgnoreEfficiencyMultiplier>true</IgnoreEfficiencyMultiplier>
      <IsPrimary>true</IsPrimary>
    </Blueprint>
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>MagRail_Rail</SubtypeId>
      </Id>
      <DisplayName>DisplayName_Item_MagRail_Rail</DisplayName>
      <Icon>Textures\Icons\MagRail_Rail.dds</Icon>
      <Prerequisites>
        <Item Amount="20" TypeId="Ingot" SubtypeId="Iron" />
        <Item Amount="5" TypeId="Ingot" SubtypeId="Nickel" />
        <Item Amount="2.5" TypeId="Ingot" SubtypeId="Cobalt" />
      </Prerequisites>
      <Result Amount="1" TypeId="Component" SubtypeId="MagRail_Rail" />
      <BaseProductionTimeInSeconds>2</BaseProductionTimeInSeconds>
      <IsPrimary>true</IsPrimary>
    </Blueprint>
  </Blueprints>
  <BlueprintClassEntries>
    <Entry Class="EliteTools" BlueprintSubtypeId="MagRail_RailLinker" />
    <Entry Class="Components" BlueprintSubtypeId="MagRail_Rail" />
  </BlueprintClassEntries>
</Definitions>
