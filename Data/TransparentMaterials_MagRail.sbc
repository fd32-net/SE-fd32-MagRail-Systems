      <Texture>Textures\Overlay\Dot.dds</Texture>
      <UseAtlas>false</UseAtlas>
      <Reflectivity>0</Reflectivity>
    </TransparentMaterial>
    <!-- HUD windows (Visuals/Hud.cs, HudPanel.cs): drawn after post-processing, in the order given (no sorting).
         Blank and the font pages are the GAME's textures (Content/Textures/GUI, Content/Fonts/white; HudFont.cs reads
         the matching FontData*.xml): MagRail_Font_<page file name>. -->
