<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- Rail component: track blocks and spans are built from it (2 narrow, 4 wide per block / 2.5 m span segment;
       a segment is finished at all but one: TrackStyle.Working; PLAN 10.8; half of the first one, 2026-10-23).
       Model: a 1 m piece of the narrow rail (ModelSource/blocks/RailComponent.py); icon rendered
       from it (ModelSource/build_icons.py). Recipe in Blueprints_MagRail.sbc.
       MaxIntegrity as a steel plate's (about as much iron): a weld segment holds its Rails' (SpanDamage). -->
  <Components>
    <Component>
      <Id>
        <TypeId>Component</TypeId>
        <SubtypeId>MagRail_Rail</SubtypeId>
      </Id>
      <DisplayName>DisplayName_Item_MagRail_Rail</DisplayName>
      <Description>Description_Item_MagRail_Rail</Description>
      <Icon>Textures\Icons\MagRail_Rail.dds</Icon>
      <Size>
        <X>0.2</X>
        <Y>0.16</Y>
        <Z>1</Z>
      </Size>
      <Mass>20</Mass>
      <Volume>20</Volume>
      <Model>Models\Components\MagRail_Rail.mwm</Model>
      <PhysicalMaterial>Metal</PhysicalMaterial>
      <MaxIntegrity>100</MaxIntegrity>
      <DropProbability>0.5</DropProbability>
    </Component>
  </Components>
</Definitions>
