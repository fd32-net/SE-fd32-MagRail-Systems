<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- Rail component: track blocks are built from it (1 narrow, 2 wide); spans will cost it later (PLAN 10.8).
       Model: a 1 m piece of the narrow rail (ModelSource/blocks/RailComponent.py); icon rendered
       from it (ModelSource/build_icons.py). Recipe in Blueprints_MagRail.sbc. -->
  <Components>
    <Component>
      <Id>
        <TypeId>Component</TypeId>
        <SubtypeId>MagRail_Rail</SubtypeId>
      </Id>
      <DisplayName>DisplayName_Item_MagRail_Rail</DisplayName>
      <Description>Description_Item_MagRail_Rail</Description>
      <Icon>Textures\Icons\MagRail_Rail.dds</Icon>
      <Size>
        <X>0.2</X>
        <Y>0.16</Y>
        <Z>1</Z>
      </Size>
      <Mass>40</Mass>
      <Volume>40</Volume>
      <Model>Models\Components\MagRail_Rail.mwm</Model>
      <PhysicalMaterial>Metal</PhysicalMaterial>
      <MaxIntegrity>100</MaxIntegrity>
      <DropProbability>0.5</DropProbability>
    </Component>
  </Components>
</Definitions>
